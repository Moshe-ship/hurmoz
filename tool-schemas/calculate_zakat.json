          "slot_type": "identifier",
          "script": "latn",
          "mode": "advisory"
        }
      },
      "type": {
        "type": "string",
        "enum": ["cash", "gold", "silver", "stocks", "business"],
        "description": "Type of wealth being zakat-ed.",
        "x-mtg": {
          "slot_type": "identifier",
          "script": "latn",
          "mode": "advisory"
        }
      }
    },
    "required": ["amount", "currency"]
