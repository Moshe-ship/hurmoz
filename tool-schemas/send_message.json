{
  "name": "send_message",
  "description": "Send a message via WhatsApp, SMS, Telegram, or email — preserving the user's Arabic register (Hurmoz 'unifonic' + 'whisper-arabic' skills).",
  "parameters": {
    "type": "object",
    "properties": {
      "recipient": {
        "type": "string",
        "description": "Recipient name or phone/email.",
        "x-mtg": {
          "slot_type": "named_entity",
          "script": "mixed",
          "transliteration_allowed": true,
          "mode": "advisory"
        }
      },
      "platform": {
        "type": "string",
        "enum": ["whatsapp", "sms", "telegram", "email"],
        "description": "Messaging platform.",
        "x-mtg": {
          "slot_type": "identifier",
          "script": "latn",
          "mode": "advisory"
        }
      },
      "message": {
        "type": "string",
        "description": "Message body — must preserve the user's Arabic dialect and script.",
        "x-mtg": {
          "slot_type": "free_text",
          "script": "ar",
          "dialect_expected": "any",
          "dialect_enforcement": "preserve",
          "transliteration_allowed": false,
          "mode": "advisory",
          "post_call_contract": ["script_match", "dialect_preserve", "no_surface_corruption"]
        }
      }
    },
    "required": ["recipient", "platform", "message"]
  }
}
